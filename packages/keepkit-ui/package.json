{
  "name": "@keepkit/ui",
  "version": "0.19.0",
  "description": "Headless, accessible React UI components for KeepKit.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nitta-a/keepkit.git",
    "directory": "packages/keepkit-ui"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": {
      "default": "./dist/theme.css"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js"
    },
    "./tailwind.css": {
      "default": "./dist/tailwind.css"
    },
    "./styles/base.css": {
      "default": "./dist/styles/base.css"
    },
    "./styles/button.css": {
      "default": "./dist/styles/button.css"
    },
    "./styles/collection.css": {
      "default": "./dist/styles/collection.css"
    },
    "./styles/status.css": {
      "default": "./dist/styles/status.css"
    },
    "./styles/sync.css": {
      "default": "./dist/styles/sync.css"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-theme.mjs",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/index.test.ts && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@keepkit/core": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
