{
  "name": "keepkit-monorepo",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "package:check": "node scripts/check-package.mjs",
    "release:check": "node scripts/check-release-version.mjs",
    "release:published-check": "node scripts/check-published-release.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:biome": "biome lint .",
    "lint:biome:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test:browser": "playwright test",
    "typecheck:browser": "pnpm --filter @keepkit/ui exec tsc -p test/browser/tsconfig.json"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.1",
    "turbo": "^2.10.12"
  }
}
